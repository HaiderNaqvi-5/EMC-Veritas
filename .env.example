# Backend
APP_ENV=development
API_PREFIX=/api
FRONTEND_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=emc-veritas
SESSION_SECRET=replace_with_a_long_random_secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
EMAIL_DELIVERY_MODE=console
# Set EMAIL_DELIVERY_MODE=provider only after configuring a provider such as
# Brevo. Keep credentials in the deployed environment, never in Git.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_smtp_login
SMTP_PASSWORD=your_brevo_smtp_key
EMAIL_FROM=EMC Veritas <no-reply@example.edu>

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
